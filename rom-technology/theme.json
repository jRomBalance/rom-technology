{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "rom-navy",       "color": "#0d1b2a", "name": "ROM Navy" },
        { "slug": "rom-navy-mid",   "color": "#0f2236", "name": "ROM Navy Mid" },
        { "slug": "rom-slate",      "color": "#1e293b", "name": "ROM Slate" },
        { "slug": "rom-slate-mid",  "color": "#334155", "name": "ROM Slate Mid" },
        { "slug": "rom-green-dark", "color": "#1b4332", "name": "ROM Green Dark" },
        { "slug": "rom-green",      "color": "#2d6a4f", "name": "ROM Green" },
        { "slug": "rom-green-mid",  "color": "#40916c", "name": "ROM Green Mid" },
        { "slug": "rom-green-light","color": "#52b788", "name": "ROM Green Light" },
        { "slug": "rom-blue",       "color": "#7eb8d4", "name": "ROM Blue" },
        { "slug": "rom-silver",     "color": "#94a3b8", "name": "ROM Silver" },
        { "slug": "rom-white",      "color": "#ffffff", "name": "ROM White" },
        { "slug": "rom-text",       "color": "#e2e8f0", "name": "ROM Text" }
      ],
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Segoe UI', system-ui, -apple-system, sans-serif",
          "slug": "rom-sans",
          "name": "ROM Sans"
        },
        {
          "fontFamily": "'Arial Black', 'Helvetica Neue', Impact, sans-serif",
          "slug": "rom-display",
          "name": "ROM Display"
        },
        {
          "fontFamily": "ui-monospace, 'Courier New', monospace",
          "slug": "rom-mono",
          "name": "ROM Mono"
        }
      ],
      "fontSizes": [
        { "slug": "xs",   "size": "0.72rem",  "name": "XS" },
        { "slug": "sm",   "size": "0.875rem", "name": "Small" },
        { "slug": "md",   "size": "1rem",     "name": "Medium" },
        { "slug": "lg",   "size": "1.25rem",  "name": "Large" },
        { "slug": "xl",   "size": "1.5rem",   "name": "XL" },
        { "slug": "2xl",  "size": "2rem",     "name": "2XL" },
        { "slug": "3xl",  "size": "2.5rem",   "name": "3XL" },
        { "slug": "4xl",  "size": "3.5rem",   "name": "4XL" }
      ],
      "fluid": true
    },
    "spacing": {
      "spacingScale": {
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem",
        "operator": "*",
        "increment": 1.5,
        "type": "fluid"
      },
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "layout": {
      "contentSize": "860px",
      "wideSize": "1200px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "#0d1b2a",
      "text": "#e2e8f0"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--rom-sans)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": { "text": "#52b788" },
        ":hover": { "color": { "text": "#7eb8d4" } }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--rom-display)",
          "fontSize": "var(--wp--preset--font-size--4xl)",
          "fontWeight": "900",
          "lineHeight": "1.1",
          "letterSpacing": "-0.5px"
        },
        "color": { "text": "#ffffff" }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--rom-display)",
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "fontWeight": "900",
          "lineHeight": "1.15"
        },
        "color": { "text": "#ffffff" }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "700"
        },
        "color": { "text": "#e2e8f0" }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontWeight": "700"
        },
        "color": { "text": "#e2e8f0" }
      },
      "button": {
        "color": {
          "background": "#2d6a4f",
          "text": "#ffffff"
        },
        "typography": { "fontWeight": "700" },
        "border": { "radius": "30px" },
        ":hover": {
          "color": { "background": "#1b4332" }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "color": { "text": "#e2e8f0" },
        "typography": { "fontWeight": "600" }
      },
      "core/separator": {
        "color": { "text": "#1e293b" },
        "border": { "color": "#1e293b" }
      },
      "core/quote": {
        "border": {
          "color": "#2d6a4f",
          "style": "solid",
          "width": "0 0 0 4px"
        },
        "color": { "text": "#94a3b8" },
        "spacing": { "padding": { "left": "1.5rem" } }
      },
      "core/code": {
        "color": {
          "background": "#1e293b",
          "text": "#52b788"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--rom-mono)",
          "fontSize": "var(--wp--preset--font-size--sm)"
        }
      }
    }
  }
}